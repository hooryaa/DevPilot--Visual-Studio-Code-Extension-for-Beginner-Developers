{
  "author": "Hooria Amir",
  "name": "devpilot-ai-assistant-hooria",
  "displayName": "DevPilot AI",
  "description": "AI-powered developer productivity suite for Visual Studio Code with AST analysis, learning tools, Git assistance, and optional OpenAI or Gemini integrations.",
  "version": "1.0.1",
  "license": "MIT",
  "main": "./out/extension.js",
  "publisher": "devpilotorg",
  "homepage": "https://github.com/hooryaa/DevPilot--Visual-Studio-Code-Extension-for-Beginner-Developers",
  "bugs": {
    "url": "https://github.com/hooryaa/DevPilot--Visual-Studio-Code-Extension-for-Beginner-Developers/issues"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hooryaa/DevPilot--Visual-Studio-Code-Extension-for-Beginner-Developers.git"
  },
  "engines": {
    "vscode": "^1.116.0"
  },
  "keywords": [
    "ai",
    "assistant",
    "developer",
    "vscode",
    "extension",
    "typescript",
    "javascript",
    "python",
    "chatgpt",
    "gemini",
    "openai",
    "ast",
    "analysis",
    "learning",
    "refactoring",
    "git",
    "commit",
    "code",
    "productivity",
    "education"
  ],
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onUri:devpilot",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:java",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:html",
    "onLanguage:css",
    "onCommand:devpilot.signIn",
    "onCommand:devpilot.signInGitHub",
    "onCommand:devpilot.signInGoogle",
    "onCommand:devpilot.signOut",
    "onCommand:devpilot.checkAuthStatus",
    "onCommand:devpilot.showWelcome",
    "onCommand:devpilot.configureGoogleOAuth",
    "onCommand:devpilot.configureAIProvider",
    "onCommand:devpilot.setGeminiKey",
    "onCommand:devpilot.suggestFix",
    "onCommand:devpilot.translateCode",
    "onCommand:devpilot.showTodos",
    "onCommand:devpilot.showAchievements"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devpilot",
          "title": "DevPilot",
          "icon": "media/icon-activity.svg"
        }
      ]
    },
    "views": {
      "devpilot": [
        {
          "id": "devpilot.dashboard",
          "name": "Dashboard",
          "type": "webview"
        },
        {
          "id": "devpilot.chatSidebar",
          "name": "DevAI",
          "type": "webview"
        },
        {
          "id": "devpilot.learning",
          "name": "Learning Resources",
          "type": "webview"
        },
        {
          "id": "devpilot.commitMessage",
          "name": "Commit Message",
          "type": "webview"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "getting-started",
        "title": "DevPilot — Getting Started",
        "description": "Set up your AI provider, open the dashboard, and try your first workflow.",
        "steps": [
          {
            "title": "Welcome",
            "markdown": "docs/walkthrough/welcome.md"
          },
          {
            "title": "Choose AI Provider",
            "markdown": "docs/walkthrough/provider.md"
          },
          {
            "title": "Configure API Key",
            "markdown": "docs/walkthrough/api-key.md"
          },
          {
            "title": "Open Dashboard",
            "markdown": "docs/walkthrough/dashboard.md"
          },
          {
            "title": "Try Hover Analysis",
            "markdown": "docs/walkthrough/hover-analysis.md"
          },
          {
            "title": "Generate Commit Message",
            "markdown": "docs/walkthrough/commit-message.md"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "devpilot.suggestFix",
        "title": "Suggest Fix",
        "category": "DevPilot"
      },
      {
        "command": "devpilot.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "DevPilot"
      },
      {
        "command": "devpilot.showCommitSuggestions",
        "title": "Show Commit Suggestions",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.analyzeStagedChanges",
        "title": "Analyze Staged Changes",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.showTodos",
        "title": "Show All TODOs",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.markTodoDone",
        "title": "Mark TODO Done",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.increaseTodoPriority",
        "title": "Increase TODO Priority",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.decreaseTodoPriority",
        "title": "Decrease TODO Priority",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.deleteTodo",
        "title": "Delete TODO",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.showAchievements",
        "title": "Show Achievements",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.signIn",
        "title": "Sign In",
        "category": "DevPilot"
      },
      {
        "command": "devpilot.signInGitHub",
        "title": "Sign In with GitHub (Recommended)",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.signInGoogle",
        "title": "Sign In with Google",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.signOut",
        "title": "Sign Out",
        "category": "DevPilot"
      },
      {
        "command": "devpilot.showGettingStarted",
        "title": "Show Getting Started",
        "category": "DevPilot"
      },
      {
        "command": "devpilot.configureAIProvider",
        "title": "Configure AI Provider",
        "category": "DevPilot"
      },
      {
        "command": "devpilot.setOpenAIKey",
        "title": "Set OpenAI API Key",
        "category": "DevPilot"
      },
      {
        "command": "devpilot.setGeminiKey",
        "title": "Set Gemini API Key",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.removeGeminiKey",
        "title": "Remove Gemini API Key",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.removeOpenAIKey",
        "title": "Remove OpenAI API Key",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.chatWithDevAI",
        "title": "Chat with DevAI",
        "category": "DevPilot"
      },
      {
        "command": "devpilot.clearChatHistory",
        "title": "Clear Chat History",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.exportChat",
        "title": "Export Chat as Markdown",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.openChatbot",
        "title": "Open AI Chatbot",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.chatSidebar.focus",
        "title": "Focus Chat Sidebar",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.learning.focus",
        "title": "Focus Learning Resources",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.commitMessage.focus",
        "title": "Focus Commit Message Generator",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.openQuiz",
        "title": "Take a Quiz",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.translateCode",
        "title": "Translate Code",
        "category": "DevPilot",
        "description": "Translate selected code between programming languages with auth enforcement"
      },
      {
        "command": "devpilot.openHelp",
        "title": "Show Help",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.checkLearningStreak",
        "title": "Check Learning Streak",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.markTodoComplete",
        "title": "Mark TODO Complete",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.showFileTodoStats",
        "title": "Show File TODO Stats",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.showTodoAction",
        "title": "Show TODO Action Menu",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.configureSuggestions",
        "title": "Configure Suggestions",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.checkAuthStatus",
        "title": "Check Authentication Status",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.configureGoogleOAuth",
        "title": "Configure Google OAuth",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.trackLearningActivity",
        "title": "Track Learning Activity",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.showWelcome",
        "title": "Show Welcome",
        "category": "DevPilot",
        "commandPalette": false
      },
      {
        "command": "devpilot.showGettingStarted",
        "title": "Show Getting Started",
        "category": "DevPilot",
        "commandPalette": true
      }
    ],
    "languages": [
      {
        "id": "javascript",
        "extensions": [
          ".js"
        ]
      },
      {
        "id": "typescript",
        "extensions": [
          ".ts"
        ]
      },
      {
        "id": "html",
        "extensions": [
          ".html"
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "devpilot.chatWithDevAI"
        },
        {
          "command": "devpilot.suggestFix"
        },
        {
          "command": "devpilot.generateCommitMessage"
        },
        {
          "command": "devpilot.translateCode"
        },
        {
          "command": "devpilot.configureAIProvider"
        },
        {
          "command": "devpilot.setOpenAIKey"
        },
        {
          "command": "devpilot.showGettingStarted"
        },
        {
          "command": "devpilot.signIn"
        }
      ]
    },
    "keybindings": [
      {
        "command": "devpilot.suggestFix",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorTextFocus"
      },
      {
        "command": "devpilot.generateCommitMessage",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus"
      },
      {
        "command": "devpilot.chatWithDevAI",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus"
      },
      {
        "command": "devpilot.showTodos",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "editorTextFocus"
      },
      {
        "command": "devpilot.analyzeStagedChanges",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "editorTextFocus"
      },
      {
        "command": "devpilot.signInGoogle",
        "key": "ctrl+shift+alt+g",
        "mac": "cmd+shift+alt+g",
        "when": "editorTextFocus"
      },
      {
        "command": "devpilot.signOut",
        "key": "ctrl+shift+alt+l",
        "mac": "cmd+shift+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "devpilot.checkAuthStatus",
        "key": "ctrl+shift+alt+a",
        "mac": "cmd+shift+alt+a",
        "when": "editorTextFocus"
      }
    ],
    "colors": [
      {
        "id": "devpilot.dashboardBackground",
        "description": "Background color for DevPilot dashboard",
        "defaults": {
          "dark": "#1e1e1e",
          "light": "#ffffff",
          "highContrast": "#000000"
        }
      },
      {
        "id": "devpilot.dashboardForeground",
        "description": "Foreground color for DevPilot dashboard",
        "defaults": {
          "dark": "#ffffff",
          "light": "#000000",
          "highContrast": "#ffffff"
        }
      }
    ],
    "uriHandler": [
      {
        "pattern": "devpilot"
      }
    ],
    "authenticationProviders": [
      {
        "id": "devpilot-google",
        "label": "DevPilot Google",
        "description": "Google account authentication for DevPilot"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "DevPilot Settings",
      "properties": {
        "devpilot.enableTelemetry": {
          "type": "boolean",
          "default": false,
          "description": "Enable DevPilot usage telemetry (opt-in)."
        },
        "devpilot.googleClientId": {
          "type": "string",
          "default": "",
          "description": "Google OAuth Client ID (for Loopback authentication mode). Leave empty to use Worker mode."
        },
        "devpilot.googleClientSecret": {
          "type": "string",
          "default": "",
          "description": "Google OAuth Client Secret (for Loopback authentication mode). Keep this secret and never share it."
        },
        "devpilot.freegptUrl": {
          "type": "string",
          "default": "",
          "description": "Optional: URL of a self-hosted Free-GPT4 web API (e.g. http://127.0.0.1:5500). If set and reachable, DevPilot will use it as a local AI provider."
        },
        "devpilot.aiProvider": {
          "type": "string",
          "enum": [
            "openai",
            "gemini",
            "local"
          ],
          "default": "local",
          "description": "Choose the default AI provider for chat, explanations, refactoring suggestions, and commit generation."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "test": "jest",
    "test:watch": "jest --watch",
    "check": "tsc --noEmit",
    "lint": "eslint src",
    "compile": "tsc",
    "watch": "tsc -w",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.mjs --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "build": "npm run compile:ext && npm run build-dashboard",
    "compile:ext": "tsc -p . --outDir out",
    "build-dashboard": "node esbuild.mjs"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/vscode": "^1.116.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "jest": "^30.2.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "@babel/parser": "^7.28.6",
    "@babel/traverse": "^7.28.6",
    "@babel/types": "^7.28.6",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.11.8",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.441.0",
    "marked": "^12.0.0",
    "next-themes": "^0.4.6",
    "openai": "^6.10.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.12.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.68.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.5.1",
    "simple-git": "^3.36.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2"
  }
}
